{
  "name": "bdo-ship-materials",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src e2e scripts worker/src worker/tests worker/scripts --max-warnings=0",
    "typecheck": "tsc -b && pnpm --dir worker typecheck",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm crafting:verify && pnpm test && pnpm --dir worker test && pnpm build && pnpm --dir worker build",
    "check:e2e": "pnpm build && pnpm test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "codex:index": "node scripts/codex-index.mjs",
    "crafting:chunks": "node scripts/build-crafting-chunks.mjs",
    "crafting:verify": "node scripts/verify-crafting-chunks.mjs",
    "crafting:recipes": "node scripts/build-recipe-index.mjs",
    "mastery:fetch": "node scripts/fetch-mastery-tables.mjs",
    "mastery:garmoth": "node scripts/build-garmoth-mastery.mjs"
  },
  "dependencies": {
    "fzstd": "0.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cheerio": "1.2.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.4",
    "vitest": "5.0.2"
  }
}
